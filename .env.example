# Copy this file to ".env" (same directory) and fill in real values before running:
#   docker compose up --build
# The .env file is gitignored — never commit it.

# SQL Server SA password
# Requirements: 8+ characters, includes uppercase, lowercase, digit, and symbol.
SQL_SA_PASSWORD=

# JWT signing secret
# MUST be at least 32 characters. Generate a cryptographically random value, for example:
#   openssl rand -base64 48
JWT_SECRET=

# JWT token metadata (optional — defaults applied if omitted)
JWT_ISSUER=ProjectTaskManager.API
JWT_AUDIENCE=ProjectTaskManager.Client

# Token lifetimes (optional — defaults: 15 minutes / 7 days)
ACCESS_TOKEN_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=7
